# =============================================================
# AI Trip Planner — Environment Variables
# Copy this file to .env (repo root) and fill in your values.
# ⚠️  Never commit .env to git — it's in .gitignore
# =============================================================

# ── Database (Phase 1 — local Docker) ────────────────────────
POSTGRES_USER=tripplanner
POSTGRES_PASSWORD=tripplanner_secret
POSTGRES_DB=tripplanner_db
DATABASE_URL=postgresql://tripplanner:tripplanner_secret@localhost:5432/tripplanner_db

# ── Redis (Phase 1 — local Docker) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ── FastAPI ────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000

# Comma-separated browser origins allowed by CORS (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000

# JWT — generate secret with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── LLM APIs ──────────────────────────────────────────────────
# Gemini — intent parsing, refinement classifier, embeddings (gemini-embedding-001)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq — itinerary builder, preference extractor
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Answers the short prompts (intent parsing, refinement classifier) when Gemini cannot —
# its free tier allows only 20 requests a day per model.
GROQ_SMALL_MODEL=openai/gpt-oss-20b

# ── External APIs (Phase 3) ────────────────────────────────────
# Flights — Duffel (https://duffel.com). A test-mode token returns sandbox offers.
DUFFEL_ACCESS_TOKEN=

# Hotels — LiteAPI by Nuitee (https://liteapi.travel). The free sandbox key (sand_…) is enough.
LITEAPI_API_KEY=

# Attractions — OpenTripMap (https://opentripmap.io)
OPENTRIPMAP_API_KEY=

# Weather — OpenWeatherMap. Optional: no planning step reads the weather yet. Cache warming (Phase 24)
# asks for it when a trip is created; without a key that one search answers "not configured" and nothing else changes.
OPENWEATHER_API_KEY=

# Geocoding uses Nominatim (OpenStreetMap) — no key.

# ── PDF export (Phase 19) ──────────────────────────────────────
# Tiles for the static map in the exported PDF. Optional: the default is OpenStreetMap's own
# tile server, which needs no key and is fine for development. For production, point this at a
# tile provider you have an account with (same idea as NEXT_PUBLIC_MAP_TILE_URL in the frontend).
# Set MAP_TILE_URL to nothing to export without a map.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors

# ── Cache warming (Phase 24) ───────────────────────────────────
# Creating a trip starts its flight, hotel, weather and attraction searches
# in the background, so that planning finds them cached. Each trip created costs one flight search
# of the provider's 30 a minute, planned or not — set this to false where that is too much.
# CACHE_WARMING_ENABLED=true

# ── Observability (Phase 26; Sentry: Phase 27) ─────────────────
# LangSmith tracing (Phase 26). With TRACING_V2=true and a key, every planning run is uploaded to
# your LangSmith project as a trace — every step a span, tagged with the trip and the user, so
# "trip_id" in LangSmith's filter shows every decision made for one trip. A trace holds what the
# planner saw and wrote: the destination, the dates, the travellers' names and interests, the plan.
# A key: https://smith.langchain.com → Settings → API Keys. Without one, tracing stays off.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tripplanner-ai
# Another LangSmith (https://eu.api.smith.langchain.com, a self-hosted one), or the local stand-in
# that prints each trace in a terminal and needs no account: python scripts/trace_receiver.py,
# then LANGCHAIN_ENDPOINT=http://localhost:1984 with any LANGCHAIN_API_KEY. Empty: LangSmith's own.
# LANGCHAIN_ENDPOINT=

# What the models cost (Phase 26). Each run that asked a model records its tokens and their list
# price; GET /admin/cost-summary adds them up. A warning is logged when one trip passes this many
# dollars (0 = never). On a free tier nothing is charged: the figures are what the tokens would cost.
# LLM_COST_ALERT_USD=0.10
# Prices the app does not know, or knows wrongly — USD per million tokens, [input, output]. The
# figures in this example only show the format: look the real ones up on the provider's pricing page.
# LLM_PRICES={"gemini-3.5-flash": [0.50, 3.00]}
SENTRY_DSN=

# ── Production Infrastructure (Phase 27) ──────────────────────
# Neon (Postgres): uncomment and fill when switching from local Docker
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/tripplanner_db?sslmode=require

# Upstash (Redis): uncomment and fill when switching from local Docker
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6380
