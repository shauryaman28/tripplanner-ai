# =============================================================
# AI Trip Planner — Environment Variables
# Copy this file to .env (repo root) and fill in your values.
# ⚠️  Never commit .env to git — it's in .gitignore
# =============================================================

# ── Database (Phase 1 — local Docker) ────────────────────────
POSTGRES_USER=tripplanner
POSTGRES_PASSWORD=tripplanner_secret
POSTGRES_DB=tripplanner_db
DATABASE_URL=postgresql://tripplanner:tripplanner_secret@localhost:5432/tripplanner_db

# ── Redis (Phase 1 — local Docker) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ── FastAPI ────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000

# Comma-separated browser origins allowed by CORS (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000

# JWT — generate secret with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── LLM APIs ──────────────────────────────────────────────────
# Gemini Flash — intent parsing (orchestrator + sub-agents), refinement classifier
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq (Llama 3.3) — ItineraryBuilder
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Claude Haiku 4.5 — PreferenceExtractor (optional: falls back to a heuristic without it)
ANTHROPIC_API_KEY=

# OpenAI text-embedding-3-small — embeddings (optional: rows are marked pending_retry without it)
OPENAI_API_KEY=

# ── External APIs (Phase 3) ────────────────────────────────────
# Flights — Duffel (https://duffel.com, test-mode token works)
DUFFEL_ACCESS_TOKEN=

# Hotels — Amadeus. The self-service portal was shut down on 2026-07-17, so
# leave these blank unless you have enterprise credentials: search_hotels then
# returns ToolError(API_NOT_CONFIGURED) and trips are planned without a hotel.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Attractions / weather
OPENTRIPMAP_API_KEY=
OPENWEATHER_API_KEY=

# ── Observability (Phase 26+) ──────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tripplanner-ai
SENTRY_DSN=

# ── Production Infrastructure (Phase 27) ──────────────────────
# Neon (Postgres): uncomment and fill when switching from local Docker
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/tripplanner_db?sslmode=require

# Upstash (Redis): uncomment and fill when switching from local Docker
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6380
