# =============================================================
# AI Trip Planner — Environment Variables
# Copy this file to .env (repo root) and fill in your values.
# ⚠️  Never commit .env to git — it's in .gitignore
# =============================================================

# ── Database (Phase 1 — local Docker) ────────────────────────
POSTGRES_USER=tripplanner
POSTGRES_PASSWORD=tripplanner_secret
POSTGRES_DB=tripplanner_db
DATABASE_URL=postgresql://tripplanner:tripplanner_secret@localhost:5432/tripplanner_db

# ── Redis (Phase 1 — local Docker) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ── FastAPI ────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000

# Comma-separated browser origins allowed by CORS (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000

# JWT — generate secret with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Phase 35 — staying signed in: a refresh token is good for REFRESH_TOKEN_DAYS, used once each, and a
# sign-in ends REFRESH_SESSION_DAYS after it began however often it was refreshed. A refresh token used
# again more than REFRESH_REUSE_GRACE_S seconds after it was used ends its sign-in. The browser keeps it
# in an HttpOnly cookie sent only to REFRESH_COOKIE_PATH — the sign-in routes as the site's /api proxy has them.
REFRESH_TOKEN_DAYS=14
REFRESH_SESSION_DAYS=30
REFRESH_REUSE_GRACE_S=10
REFRESH_COOKIE_PATH=/api/auth
# Phase 35 — sign-in attempts and new accounts one address may make in any 60 seconds (429 past it).
# 0 turns a limit off: only for a stack loaded from one address on purpose (the load test's sets it).
LOGIN_ATTEMPTS_PER_MINUTE=5
REGISTRATIONS_PER_MINUTE=5

# ── LLM APIs ──────────────────────────────────────────────────
# Gemini — intent parsing, refinement classifier, embeddings (gemini-embedding-001)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq — itinerary builder, preference extractor
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Answers the short prompts (intent parsing, refinement classifier) when Gemini cannot —
# its free tier allows only 20 requests a day per model.
GROQ_SMALL_MODEL=openai/gpt-oss-20b

# ── External APIs (Phase 3) ────────────────────────────────────
# Flights — Duffel (https://duffel.com). A test-mode token returns sandbox offers.
DUFFEL_ACCESS_TOKEN=

# Hotels — LiteAPI by Nuitee (https://liteapi.travel). The free sandbox key (sand_…) is enough.
LITEAPI_API_KEY=

# Attractions — OpenTripMap (https://opentripmap.io)
OPENTRIPMAP_API_KEY=

# Weather — OpenWeatherMap. Optional: no planning step reads the weather yet. Cache warming (Phase 24)
# asks for it when a trip is created; without a key that one search answers "not configured" and nothing else changes.
OPENWEATHER_API_KEY=

# Google Maps Platform — the Routes API, for travel times between a day's stops (Phase 37). A key of a Google
# Cloud project with billing and the Routes API enabled, restricted to it (HOW_TO_RUN Step 35). Without one,
# travel times are estimated from the straight-line distance, and the plan says so.
GOOGLE_MAPS_API_KEY=

# Geocoding uses Nominatim (OpenStreetMap) — no key.

# ── PDF export (Phase 19) ──────────────────────────────────────
# Tiles for the static map in the exported PDF. Optional: the default is OpenStreetMap's own
# tile server, which needs no key and is fine for development. For production, point this at a
# tile provider you have an account with (same idea as NEXT_PUBLIC_MAP_TILE_URL in the frontend).
# Set MAP_TILE_URL to nothing to export without a map.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors

# ── Cache warming (Phase 24) ───────────────────────────────────
# Creating a trip starts its flight, hotel, weather and attraction searches
# in the background, so that planning finds them cached. Each trip created costs one flight search
# of the provider's 30 a minute, planned or not — set this to false where that is too much.
# CACHE_WARMING_ENABLED=true

# ── Observability (Phase 26; Sentry: Phase 27) ─────────────────
# LangSmith tracing (Phase 26). With TRACING_V2=true and a key, every planning run is uploaded to
# your LangSmith project as a trace — every step a span, tagged with the trip and the user, so
# "trip_id" in LangSmith's filter shows every decision made for one trip. A trace holds what the
# planner saw and wrote: the destination, the dates, the travellers' names and interests, the plan.
# A key: https://smith.langchain.com → Settings → API Keys. Without one, tracing stays off.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tripplanner-ai
# Another LangSmith (https://eu.api.smith.langchain.com, a self-hosted one), or the local stand-in
# that prints each trace in a terminal and needs no account: python scripts/trace_receiver.py,
# then LANGCHAIN_ENDPOINT=http://localhost:1984 with any LANGCHAIN_API_KEY. Empty: LangSmith's own.
# LANGCHAIN_ENDPOINT=

# What the models cost (Phase 26). Each run that asked a model records its tokens and their list
# price; GET /admin/cost-summary adds them up. A warning is logged when one trip passes this many
# dollars (0 = never). On a free tier nothing is charged: the figures are what the tokens would cost.
# LLM_COST_ALERT_USD=0.10
# Prices the app does not know, or knows wrongly — USD per million tokens, [input, output]. The
# figures in this example only show the format: look the real ones up on the provider's pricing page.
# LLM_PRICES={"gemini-3.5-flash": [0.50, 3.00]}
# Sentry (Phase 27). With a DSN, every error nobody caught — and every planning run that crashed in
# the background — is reported to your Sentry project, and one request in ten as a performance trace.
# A report is scrubbed before it leaves: no keys, no passwords, no login tokens, no e-mail addresses,
# no request bodies and no local variables (src/backend/app/core/error_reporting.py says how).
# A DSN: https://sentry.io → new project, platform FastAPI. Empty: nothing is reported.
# Without an account: python scripts/sentry_receiver.py, then SENTRY_DSN=http://standin@localhost:9010/1
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Metrics, traces and searchable logs (Phase 29) ─────────────
# python scripts/observability.py up  starts Prometheus, Grafana, Jaeger and Loki on this machine:
#   Grafana http://localhost:3001 · Prometheus http://localhost:9090 · Jaeger http://localhost:16686
# GET /metrics is always there (Prometheus reads it). The other two are settings:
#
# Where traces are sent — OTLP over HTTP. Jaeger's, once the stack is up: http://localhost:4318
# Empty: nothing is traced, nothing is sent. A trace is what the system did (requests, SQL without
# its values, Redis commands without their arguments, tool and model calls and how long each took),
# tagged with the trip's id and the user's — not what was asked or answered: that is LangSmith's.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Headers for that endpoint (a hosted backend's key), as name=value,name=value
# OTEL_EXPORTER_OTLP_HEADERS=
# The share of requests traced, 0 to 1. A health check never is.
# OTEL_TRACES_SAMPLE_RATIO=1.0
#
# json: every log line is one JSON object with trip_id, user_id and trace_id — what a log store
# searches by. text: the console as a person reads it. Empty: json in production, text anywhere else.
# LOG_FORMAT=json

# ── Production (Phase 27) ─────────────────────────────────────
# A deployment is given its settings as environment variables — this file is not copied into the
# image. What it must be given, and what is wrong with what it has, is said in one go by:
#     python -m app.preflight --env-file <a file of the values> --production
# With APP_ENV=production the app refuses to start on the defaults above: a signing secret that is in
# the repository, a database or a Redis on localhost, an origin list with only localhost in it.
#
# APP_ENV=production
#
# The database (Neon): the POOLED connection string, exactly as it is handed out — sslmode,
# channel_binding and all. The app translates it for its driver and keeps no prepared statement, so
# the pooler can sit in between.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Optional: the same database's direct address. Only the migrations use it.
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# How many database connections one instance may hold (Phase 30): DB_POOL_SIZE kept open, up to
# DB_MAX_OVERFLOW more when those are all in use. Past the two together a request waits for one. The
# defaults are 5 and 10. Behind a pooler the two together, times the instances alive at once (two
# during a deploy), must fit in what the pooler lends — Neon: 90 % of max_connections, 94 on the
# smallest compute. docs/load-test-report.md says how the numbers were arrived at.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=30
# How many connections to Redis one instance may open (Phase 30). Every open trip page keeps one, so
# this is how many pages can be open at once; past it commands fail, they do not wait. The default is
# 100. Keep it under your Redis plan's own limit of concurrent connections.
# REDIS_MAX_CONNECTIONS=500
#
# Redis (Upstash): the rediss:// URL — TCP with TLS. NOT the REST URL (https://…): a REST API cannot
# subscribe, and the live progress of a plan is a subscription.
# REDIS_URL=rediss://default:password@xxx.upstash.io:6379
#
# The deployed frontend's origin — the page opens its event stream straight from the browser to the
# API, and the browser asks the API whether it may. No path, no trailing slash.
# CORS_ORIGINS=https://your-app.vercel.app
# Origins allowed by pattern too, for a host that gives every deployment an address of its own:
# CORS_ORIGIN_REGEX=^https://your-app-[a-z0-9-]+\.vercel\.app$
#
# A secret for operating the deployment (openssl rand -hex 32). It opens two doors:
#   GET /admin/sentry-test (header X-Ops-Token) — fails on purpose, so that error reporting can be
#     seen to work. Empty: that route does not exist.
#   GET /metrics (header Authorization: Bearer …, which is what Prometheus sends — Phase 29).
#     Empty: in production the metrics are closed to everyone; anywhere else they are open.
# OPS_TOKEN=
#
# Which commit this deployment was built from (Phase 28). The pipeline that deploys sets it — never by
# hand — and GET /version answers with it, which is how a deploy is known to be live.
# GIT_COMMIT_SHA=
#
# How long a stopping server waits for the plans it is making before giving them up. The platform's
# own grace period must be longer (railway.json: drainingSeconds).
# SHUTDOWN_GRACE_SECONDS=40
#
# The frontend (Vercel) is given two of its own, before it BUILDS — src/frontend/.env.local.example:
#   BACKEND_URL=https://<the backend's address>           the /api/* proxy's destination
#   NEXT_PUBLIC_API_URL=https://<the backend's address>   where the browser opens the event stream
