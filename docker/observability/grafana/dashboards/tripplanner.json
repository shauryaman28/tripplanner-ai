      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=~\"$job\", handler!~\"/ready|/ping|/version|none\"}[5m]))",
          "legendFormat": "",
          "range": true,
          "editorMode": "code"
