# FastAPI backend URL for server-side proxy
BACKEND_URL=http://localhost:8000

# Direct URL for SSE EventSource (cannot go through Next.js proxy)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Both are read when the site is BUILT. For a deployment (Phase 27) set them, as https:// addresses
# of the deployed backend, in the host's own settings before it builds — on Vercel the build stops
# if either is missing. The backend must in turn allow this site's origin: CORS_ORIGINS there.

# Optional — map tiles (Phase 18). Default: OpenStreetMap's standard tiles, which are
# fine for development; use a hosted tile provider in production.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
